# Bootstrap config and secrets. Copy to .env and fill in what you need.
# Everything that changes more often than the code lives in the DB instead:
#   hawa settings show

# SQLite by default. Postgres: postgresql+psycopg://user:pass@host/db
HAWA_DATABASE_URL=sqlite:///./hawa.db

# Needed for Telegram alerts. Get one from @BotFather.
HAWA_TELEGRAM_BOT_TOKEN=

# Optional air-quality sources. Absent key => the source is skipped, not failed.
HAWA_PURPLEAIR_API_KEY=
HAWA_OPENAQ_API_KEY=

# Poll cadence. PMD publishes once a day; please do not lower this.
HAWA_POLL_INTERVAL_MINUTES=30
HAWA_ENABLE_SCHEDULER=true
